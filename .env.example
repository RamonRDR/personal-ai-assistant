# Local-first demo. Do not commit real secrets.
PA_DATABASE_URL=sqlite:///./assistant.db
PA_MODE=demo
PA_TIMEZONE=UTC
PA_HISTORY_LIMIT=12
PA_HISTORY_RETENTION_DAYS=30
PA_MAX_TOOL_CALLS=4
PA_APPROVAL_TTL_SECONDS=600
# Optional, only when choosing an OpenAI-compatible model explicitly:
# PA_MODE=openai_compatible
# PA_LLM_BASE_URL=https://api.openai.com/v1
# PA_LLM_MODEL=gpt-4o-mini
# PA_LLM_API_KEY=replace-me
# PA_LLM_MAX_TOKENS=512
# PA_LLM_TIMEOUT_SECONDS=20
